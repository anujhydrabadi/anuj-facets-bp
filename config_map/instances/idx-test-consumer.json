{
  "kind": "config_map",
  "flavor": "k8s",
  "version": "0.3",
  "metadata": {
    "name": "idx-test-consumer"
  },
  "disabled": false,
  "spec": {
    "data": {
      "FIRST_NAT_GW": "${network.idx-test-vpc.out.attributes.nat_gateway_ids[0]}",
      "FIRST_PRIVATE_SUBNET": "${network.idx-test-vpc.out.attributes.private_subnet_ids[0]}",
      "ALL_AZS_SPLAT": "${network.idx-test-vpc.out.attributes.availability_zones[*]}",
      "WHOLE_LIST": "${network.idx-test-vpc.out.attributes.public_subnet_ids}",
      "VPC_ID": "${network.idx-test-vpc.out.attributes.vpc_id}",
      "NEG_TYPO_LIST": "${network.idx-test-vpc.out.attributes.private_subnet_idz[0]}",
      "NEG_INDEX_SCALAR": "${network.idx-test-vpc.out.attributes.vpc_id[0]}"
    }
  }
}